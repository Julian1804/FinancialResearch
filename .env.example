# =========================
# LLM / API settings
# =========================
ALIYUN_API_KEY=""
ALIYUN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=""

# Default active model profile name
DEFAULT_LLM_PROFILE="aliyun_text_free"

# =========================
# Application and storage settings
# =========================
FINANCIAL_RESEARCH_APP_NAME="FinancialResearch"
FINANCIAL_RESEARCH_APP_ENV="local"
FINANCIAL_RESEARCH_RUNTIME_ROOT=""
FINANCIAL_RESEARCH_DATA_ROOT=""

# Leave these settings empty unless you already have an FR installation that uses them.
# Editing this example does not initialize a new financial database.
FR_LOCAL_STORAGE_ROOT=""
FR_NAS_ROOT=""

# Parse Lab remains an independent local API capability.
PARSE_LAB_BASE_URL="http://127.0.0.1:8021"

# Optional local operational overrides.
FR_LOCALAPP_SECRET_PATH=""
FR_MORNINGSTAR_PYTHON=""

# =========================
# Parse performance tuning
# =========================
#PARSE_ENABLE_MULTIMODAL="true"
#PARSE_MAX_MULTIMODAL_PAGES="8"
#PARSE_TEXT_RESCUE_PAGE_LIMIT="30"
#PARSE_RENDER_SCALE="1.6"

# =========================
# Task runtime tuning
# =========================
TASK_LOG_LIMIT="500"
TASK_POLL_SECONDS="2"

# =========================
# Optional debug toggles
# =========================
DEBUG_JSON_PREVIEW_LIMIT="1200"
