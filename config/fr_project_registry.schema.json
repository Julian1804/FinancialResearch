{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinancialResearch Project Registry v1",
  "type": "object",
  "required": ["schema_version", "registry_id", "updated_at", "projects"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "registry_id": {"type": "string"},
    "updated_at": {"type": "string"},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project_id",
          "title",
          "research_goal",
          "hypotheses",
          "linked_datasets",
          "key_indicators",
          "data_selection",
          "notes_path",
          "reports_path",
          "ai_handoff_path",
          "exports_path",
          "status",
          "update_mode",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "project_id": {"type": "string", "pattern": "^[a-z0-9_\\-]+$"},
          "title": {"type": "string"},
          "research_goal": {"type": "string"},
          "hypotheses": {"type": "array", "items": {"type": "string"}},
          "linked_datasets": {"type": "array", "items": {"type": "string"}},
          "key_indicators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["indicator_id", "display_name", "dataset_id", "role"],
              "properties": {
                "indicator_id": {"type": "string"},
                "display_name": {"type": "string"},
                "dataset_id": {"type": "string"},
                "role": {"type": "string"},
                "gap_reason": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "data_selection": {"type": "object"},
          "notes_path": {"type": "string"},
          "reports_path": {"type": "string"},
          "ai_handoff_path": {"type": "string"},
          "exports_path": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "paused", "archived"]},
          "update_mode": {"type": "string", "enum": ["manual"]},
          "created_at": {"type": "string"},
          "updated_at": {"type": "string"},
          "known_limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
