  "universe_vocabulary": {
    "top_level_concept": "Universe",
    "structural_principle": "Universe -> real financial object -> durable FR ID -> real relationships -> data attached to the correct object",
    "version_semantics": "This is the approved current set for this vocabulary version, not a permanent limit on future FR Universes.",
    "universes": [
      {"universe_id": "equity", "display_name": "Equity"},
      {"universe_id": "fund", "display_name": "Fund"},
      {"universe_id": "fixed_income", "display_name": "Fixed Income"},
      {"universe_id": "derivatives", "display_name": "Derivatives"},
      {"universe_id": "commodity", "display_name": "Commodity"},
      {"universe_id": "index", "display_name": "Index"},
      {"universe_id": "interest_rate", "display_name": "Interest Rate"},
      {"universe_id": "foreign_exchange", "display_name": "Foreign Exchange"},
      {"universe_id": "macro", "display_name": "Macro"}
    ],
    "cross_universe_subject_types": [
      "Entity",
      "Person",
      "Document"
    ],
    "non_universe_concepts": [
      "financial statements",
      "market data",
      "research artifact",
      "read model",
      "coverage",
      "source observation"
    ],
    "classification_rule": "Universe classifies financial asset type, not geography: China Equity means Equity scoped to region China, not a separate Universe. Region, market/jurisdiction, venue, regulatory status, security or product type, board, share type, listing episode, structure, mandate, strategy, market role, tenor, trading currency and quote convention remain separate dimensions where financially applicable.",
    "dimension_model": "Universe x region x market/jurisdiction x venue x instrument/security classification x board x listing episode x trading currency/quote convention; each dimension retains its own evidence and no venue token is also a share classification.",
    "equity_scope_examples": {
      "mainland_china": "Universe=Equity; region=China; market/jurisdiction=Mainland China; venues=SSE|SZSE|BSE. Ordinary RMB shares on all three venues are A-shares; SSE/SZSE foreign-currency shares are B-shares.",
      "hong_kong": "Universe=Equity; region=China; market/jurisdiction=Hong Kong; venue=HKEX. H-share is one evidence-supported classification and is not synonymous with all Hong Kong Equity."
    },
    "operational_ownership_rule": "Mainland China Equity and Hong Kong Equity may use distinct market-specific source, identity/lifecycle and update owners; they converge through neutral Equity standard-data, serving/publication and Research contracts.",
    "foreign_exchange_boundary": "Currencies, currency pairs, spot observations and fixings belong to Foreign Exchange. Forwards, NDFs, swaps, options and other derivative contracts belong to Derivatives and relate to the relevant currencies or pairs.",
    "fund_boundary": "Public Fund and Private Fund are classifications within Fund. Region, jurisdiction, venue, product structure such as ETF or LOF, legal structure, mandate and share class are separate dimensions. China Fund means Fund scoped to region China; China Public Fund adds the public-fund classification, not another top-level Universe."
  },
  "contextual_legacy_aliases": [
    {
      "term": "A-share",
      "canonical_context": "Equity classification",
      "allowed_contexts": ["A-share security", "A-share source or data route", "A-share operation", "historical identifier"],
      "prohibited_current_use": "Do not use A-share as the formal name of the broader China Equity scope."
